<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/morandi_bg"
    android:fitsSystemWindows="true">

    <TextView
        android:id="@+id/tv_page_title_fixed"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:text="浏览"
        android:textColor="@color/morandi_text_primary"
        android:textSize="26sp"
        android:textStyle="bold" />

    <ScrollView
        android:id="@+id/scroll_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="56dp"
        android:fillViewport="true"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@color/morandi_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="选择处理哪一天"
                android:textColor="@color/morandi_text_secondary"
                android:textSize="14sp" />

            <Spinner
                android:id="@+id/spinner_day"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />

            <Button
                android:id="@+id/btn_pick_edf"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:backgroundTint="@color/morandi_primary"
                android:text="上传EDF文件"
                android:textColor="@color/white" />

            <TextView
                android:id="@+id/tv_selected_edf"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="未选择文件"
                android:textColor="@color/morandi_text_primary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tv_precheck_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="等待检查"
                android:textColor="@color/morandi_text_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@color/morandi_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="情绪分析并匹配图库图片"
                android:textColor="@color/morandi_text_secondary"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="执行策略"
                android:textColor="@color/morandi_text_secondary"
                android:textSize="13sp" />

            <RadioGroup
                android:id="@+id/rg_strategy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rb_strategy_auto"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="自动"
                    android:textColor="@color/morandi_text_primary" />

                <RadioButton
                    android:id="@+id/rb_strategy_light"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="更轻量"
                    android:textColor="@color/morandi_text_primary" />
            </RadioGroup>

            <Button
                android:id="@+id/btn_analyze_generate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:backgroundTint="@color/morandi_accent"
                android:text="推理情绪并生成情绪分布图"
                android:textColor="@color/morandi_text_primary" />

            <TextView
                android:id="@+id/tv_generation_result"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="3dp"
                android:text="等待任务执行。"
                android:textColor="@color/morandi_text_primary"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="主要情绪"
                android:textColor="@color/morandi_text_secondary"
                android:textSize="13sp" />

            <ImageView
                android:id="@+id/iv_result_image"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:layout_marginTop="6dp"
                android:background="@android:color/white"
                android:scaleType="centerCrop" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="情绪分布饼图"
                android:textColor="@color/morandi_text_secondary"
                android:textSize="13sp" />

            <ImageView
                android:id="@+id/iv_pie_chart"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:layout_marginTop="6dp"
                android:background="@android:color/white"
                android:scaleType="fitCenter" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@color/morandi_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="图片生成历史记录"
                android:textColor="@color/morandi_text_secondary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tv_image_history"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="暂无记录"
                android:textColor="@color/morandi_text_primary"
                android:textSize="14sp" />
        </LinearLayout>

        </LinearLayout>

    </ScrollView>

</FrameLayout>
